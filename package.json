{
  "name": "laundry",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrations:build": "node scripts/generate-migrations.mjs",
    "db:migrate": "drizzle-kit migrate",
    "dev:db": "node scripts/dev-db.mjs",
    "dev:api": "tsx watch src/api/server.ts",
    "start:api": "tsx src/api/server.ts",
    "worker": "tsx src/workers/index.ts",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "smoke": "node scripts/smoke-e2e.mjs",
    "db:seed": "tsx src/scripts/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.11",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "esbuild": "0.25.12",
    "minimatch": "11.0.8"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.1",
    "playwright": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "5.1.0"
  }
}
