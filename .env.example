# Local/disposable defaults. Never use these values in production.
DATABASE_URL=postgres://postgres:postgres_test_only@127.0.0.1:55432/laundry
TEST_DATABASE_URL=postgres://postgres:postgres_test_only@127.0.0.1:55432/laundry_test
PORT=3000
NODE_ENV=development

# Set to a long random value in production. Demo auth is disabled when NODE_ENV=production.
SESSION_SECRET=change-me-to-a-random-32-byte-secret

# Adapters are stubbed by default; production requires approved providers and legal sign-off.
PAYMENT_PROVIDER=fake
FISCAL_PROVIDER=stub
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=.media
