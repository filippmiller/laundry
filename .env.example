# Local/disposable defaults. Never use these values in production.
DATABASE_URL=postgres://postgres:postgres_test_only@127.0.0.1:55432/laundry
TEST_DATABASE_URL=postgres://postgres:postgres_test_only@127.0.0.1:55432/laundry_test
PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# Set to long random values in production. Demo auth is disabled when NODE_ENV=production
# unless PREVIEW_MODE=enabled AND a valid PREVIEW_ACCESS_KEY cookie is supplied.
SESSION_SECRET=change-me-to-a-random-32-byte-secret
PAYMENT_WEBHOOK_SECRET=change-me-to-a-random-32-byte-webhook-secret
PREVIEW_MODE=disabled
PREVIEW_ACCESS_KEY=

# Adapters are stubbed by default; production requires approved providers and legal sign-off.
PAYMENT_PROVIDER=fake
FISCAL_PROVIDER=stub
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=.media
# Optional external VROOM HTTP routing engine; deterministic VRPTW fallback is built-in.
VROOM_URL=
